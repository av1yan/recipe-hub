# RevenueCat public SDK key (Apple). This is a *public* client key — it is meant
# to be embedded in the shipped app, so committing it is safe and intentional.
# It is baked into the bundle at `npm run build`; the native build then picks it
# up via `cap sync`. The web build ignores it (purchases are native-only), so it
# does no harm there. The matching secret (sk_...) lives only on the backend.
VITE_REVENUECAT_IOS_KEY=appl_TOEKbdLoAOttHJqHGMVabcSfmJS

# Android's RevenueCat public key (goog_...). Unset until the Google Play side is
# set up in RevenueCat — while blank, Android builds just show "not available
# yet" instead of breaking. Fill it in to enable the Pro subscription on Android.
# VITE_REVENUECAT_ANDROID_KEY=goog_...
